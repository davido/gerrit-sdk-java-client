module(
    name = "gerrit_sdk_java_client",
    version = "0.0.0",
)

bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "rules_java", version = "9.9.0")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# Fetch the Gerrit SDK from JitPack (which builds the commit into a Maven artifact on
# demand). We pin a specific commit SHA, so the resolution is stable.
# rules_jvm_external resolves okhttp/gson/etc. from Central.
maven.install(
    artifacts = ["com.github.davido:gerrit-sdk-java:c2ce963"],
    repositories = [
        "https://jitpack.io",
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")
